{"text": "<style>\n.pz{font-family:var(--font-anthropic-sans);display:grid;gap:var(--cds-gap-lg);max-width:1100px;margin-inline:auto}\n.pz h1{font-family:var(--font-anthropic-serif);font-weight:400;font-size:var(--cds-font-size-title);margin:0}\n.pz .lead{margin:0;color:var(--color-fg-muted);font-size:var(--cds-font-size-body);max-width:70ch}\n.pz .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,10rem),1fr));gap:var(--cds-gap-md)}\n.pz .tile{background:var(--color-panel);border:1px solid var(--color-border-line);border-radius:var(--cds-radius);padding:var(--cds-pad-lg);display:grid;gap:var(--cds-gap-xs);min-width:0}\n.pz .tile .k{font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n.pz .tile .v{font-family:var(--font-anthropic-serif);font-weight:400;font-size:1.9rem;line-height:1.1;font-variant-numeric:tabular-nums}\n.pz .tile .n{font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n.pz .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,24rem),1fr));gap:var(--cds-gap-md)}\n.pz .card{background:var(--color-panel);border:1px solid var(--color-border-line);border-radius:var(--cds-radius);padding:var(--cds-pad-lg);display:grid;gap:var(--cds-gap-sm);min-width:0;position:relative}\n.pz .card h2{margin:0;font-size:var(--cds-font-size-heading);font-weight:var(--cds-font-weight-medium)}\n.pz .card .note{margin:0;font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n.pz .plot{min-height:240px}\n.pz svg{display:block;width:100%;height:auto}\n.pz .legend{display:flex;gap:var(--cds-gap-md);flex-wrap:wrap;font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n.pz .legend i{display:inline-block;width:.6rem;height:.6rem;border-radius:2px;margin-right:.35rem;vertical-align:-1px}\n.pz .tip{position:absolute;background:var(--cds-surface-popover);border:1px solid var(--cds-border);border-radius:var(--cds-radius);box-shadow:var(--cds-shadow-popover);padding:var(--cds-pad-xs) var(--cds-pad-sm);font-size:var(--cds-font-size-caption);pointer-events:none;display:none;max-width:16rem}\n.pz .tip b{font-weight:600}\n.pz .tip .d{color:var(--cds-text-secondary)}\n.pz .wrap{overflow:auto;max-height:420px}\n.pz table{border-collapse:collapse;width:100%;font-size:var(--cds-font-size-caption);font-variant-numeric:tabular-nums}\n.pz th,.pz td{text-align:right;padding:6px 8px;border-bottom:1px solid var(--color-border-line);white-space:nowrap}\n.pz th:first-child,.pz td:first-child,.pz th:nth-child(2),.pz td:nth-child(2){text-align:left}\n.pz th{position:sticky;top:0;background:var(--color-panel);color:var(--color-fg-muted);font-weight:var(--cds-font-weight-medium)}\n.pz tr.alerta td{color:var(--color-bad)}\n.pz .fail{display:flex;align-items:center;justify-content:center;gap:.4rem;color:var(--color-fg-muted);font-size:var(--cds-font-size-caption)}\n.pz .fail::before{content:\"\";width:.375rem;height:.375rem;border-radius:50%;background:var(--color-bad)}\n.pz [data-dash-source-state=empty]{color:transparent}\n.pz [data-dash-source-state=refreshing]{opacity:.5;transition:opacity var(--cds-dur-slow)}\n.pz .recs{display:grid;gap:var(--cds-gap-sm);margin:0;padding-left:1.2rem}\n.pz .recs li{font-size:var(--cds-font-size-body)}\n.pz .muestra{font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n</style>\n<div class=\"pz\">\n<header>\n  <h1 id=\"titulo\">Palenque San Isidro · producción 2025–2026</h1>\n  <p class=\"lead\" id=\"lead\" data-source=\"kpi\" data-field=\"lead\" class=\"dash-skeleton\">—</p>\n</header>\n<section class=\"tiles\" id=\"indicadores\">\n  <div class=\"tile\"><span class=\"k\">Litros producidos</span><span class=\"v\" data-source=\"kpi\" data-field=\"litros\">—</span><span class=\"n\">12 lotes · 12 meses</span></div>\n  <div class=\"tile\"><span class=\"k\">Costo por litro</span><span class=\"v\" data-source=\"kpi\" data-field=\"costo_litro\">—</span><span class=\"n\">promedio ponderado, MXN</span></div>\n  <div class=\"tile\"><span class=\"k\">Rendimiento</span><span class=\"v\" data-source=\"kpi\" data-field=\"rendimiento\">—</span><span class=\"n\">kg de agave por litro, promedio</span></div>\n  <div class=\"tile\"><span class=\"k\">Merma total</span><span class=\"v\" data-source=\"kpi\" data-field=\"merma\">—</span><span class=\"n\">horneado + molienda + fermentación + destilación</span></div>\n  <div class=\"tile\"><span class=\"k\">Litros perdidos en mermas atípicas</span><span class=\"v\" data-source=\"kpi\" data-field=\"litros_perdidos\">—</span><span class=\"n\">lotes por encima de la mediana + 5 puntos</span></div>\n</section>\n<section class=\"grid\">\n  <div class=\"card\" id=\"c-costo\"><h2>Costo por litro por lote</h2><p class=\"note\">Los lotes de agave silvestre cuestan más por litro; dentro de espadín, los picos son mermas, no agave.</p><div class=\"plot\" id=\"p-costo\" data-source=\"lotes\"></div><div class=\"tip\" id=\"t-costo\"></div></div>\n  <div class=\"card\" id=\"c-merma\"><h2>Mermas por etapa por lote</h2><p class=\"note\">Porcentaje perdido en cada etapa. Un lote sano suma 15 a 25 %.</p><div class=\"legend\" id=\"l-merma\"></div><div class=\"plot\" id=\"p-merma\" data-source=\"lotes\"></div><div class=\"tip\" id=\"t-merma\"></div></div>\n</section>\n<section class=\"grid\">\n  <div class=\"card\" id=\"c-ventas\"><h2>Litros vendidos por canal por mes</h2><p class=\"note\">Exportación paga mejor por litro; palenque es volumen chico.</p><div class=\"legend\" id=\"l-ventas\"></div><div class=\"plot\" id=\"p-ventas\" data-source=\"ventas\"></div><div class=\"tip\" id=\"t-ventas\"></div></div>\n  <div class=\"card\" id=\"c-recs\"><h2>Tres recomendaciones</h2><p class=\"note\">Calculadas de los datos; se reescriben si los datos cambian.</p><ol class=\"recs\" id=\"recs\"><li data-source=\"kpi\" data-field=\"rec1\">—</li><li data-source=\"kpi\" data-field=\"rec2\">—</li><li data-source=\"kpi\" data-field=\"rec3\">—</li></ol></div>\n</section>\n<section class=\"card\" id=\"c-tabla\"><h2>Los doce lotes</h2><p class=\"note\">En rojo, lotes con alguna merma atípica.</p>\n<div class=\"wrap\"><table id=\"tabla\" data-source=\"lotes\" data-row-key=\"lote\"><thead><tr><th data-field=\"lote\">Lote</th><th data-field=\"agave\">Agave</th><th data-field=\"kg_agave\">kg agave</th><th data-field=\"litros\">Litros</th><th data-field=\"rendimiento_kg_por_l\">kg/L</th><th data-field=\"grado\">°</th><th data-field=\"merma_fermentacion\">Merma ferm.</th><th data-field=\"merma_horneado\">Merma horno</th><th data-field=\"costo_por_litro_mxn\">$/L</th><th data-field=\"precio_venta_litro_mxn\">Precio/L</th></tr></thead><tbody></tbody></table></div></section>\n<p class=\"muestra\">Datos de muestra: un palenque ficticio con cifras realistas, preparado por CLNDA Studio para mostrar el servicio. Con sus registros reales, cada número de esta página sale de su propia producción.</p>\n</div>\n<script>\nconst num=d3.format(','), pct=d3.format('.0%'), pct1=d3.format('.1%'), mxn=d3.format(',.0f'), dec=d3.format('.1f');\nconst toRows=r=>r.map(d=>({...d,kg_agave:+d.kg_agave,litros:+d.litros,rendimiento_kg_por_l:+d.rendimiento_kg_por_l,grado:+d.grado,merma_horneado:+d.merma_horneado,merma_molienda:+d.merma_molienda,merma_fermentacion:+d.merma_fermentacion,merma_destilacion:+d.merma_destilacion,costo_total_mxn:+d.costo_total_mxn,costo_por_litro_mxn:+d.costo_por_litro_mxn,dias_proceso:+d.dias_proceso,precio_venta_litro_mxn:+d.precio_venta_litro_mxn,merma_total:+d.merma_horneado+ +d.merma_molienda+ +d.merma_fermentacion+ +d.merma_destilacion}));\ndash.calc('kpi',{inputs:['lotes'],title:'Indicadores del periodo',description:'Totales, promedios ponderados, mermas atípicas y tres recomendaciones a partir de los lotes.',fn:(lotes)=>{\n  const r=lotes.map(d=>({...d,kg:+d.kg_agave,l:+d.litros,c:+d.costo_total_mxn,mt:+d.merma_horneado+ +d.merma_molienda+ +d.merma_fermentacion+ +d.merma_destilacion,mf:+d.merma_fermentacion,mh:+d.merma_horneado,p:+d.precio_venta_litro_mxn}));\n  const litros=r.reduce((a,d)=>a+d.l,0), costo=r.reduce((a,d)=>a+d.c,0), kg=r.reduce((a,d)=>a+d.kg,0);\n  const medMt=[...r].map(d=>d.mt).sort((a,b)=>a-b)[Math.floor(r.length/2)];\n  const atip=r.filter(d=>d.mt>medMt+0.05);\n  const perdidos=atip.reduce((a,d)=>a+d.l*(d.mt-medMt)/(1-d.mt),0);\n  const esp=r.filter(d=>d.agave==='Espadín'), silv=r.filter(d=>d.agave!=='Espadín');\n  const margen=g=>g.reduce((a,d)=>a+(d.p-d.c/d.l)*d.l,0)/g.reduce((a,d)=>a+d.l,0);\n  const peorF=[...r].sort((a,b)=>b.mf-a.mf)[0], peorH=[...r].sort((a,b)=>b.mh-a.mh)[0];\n  return {litros:Math.round(litros),costo_litro:Math.round(costo/litros),rendimiento:+(kg/litros).toFixed(1),merma:+(r.reduce((a,d)=>a+d.mt*d.l,0)/litros).toFixed(3),litros_perdidos:Math.round(perdidos),\n    lead:`${Math.round(litros).toLocaleString('es-MX')} litros en 12 lotes a un costo promedio de $${Math.round(costo/litros)} por litro; ${atip.length} lotes con mermas atípicas se llevaron unos ${Math.round(perdidos)} litros, el equivalente a $${Math.round(perdidos*(costo/litros)).toLocaleString('es-MX')} de costo sin producto.`,\n    rec1:`Fermentación: el lote ${peorF.lote} perdió ${Math.round(peorF.mf*100)} % en tina contra una mediana de ${Math.round(100*[...r].map(d=>d.mf).sort((a,b)=>a-b)[Math.floor(r.length/2)])} %. Registrar temperatura y días de tina por lote permite ver la causa antes de destilar.`,\n    rec2:`Horneado: el lote ${peorH.lote} perdió ${Math.round(peorH.mh*100)} % en el horno; una merma de horneado arriba de 10 % casi siempre es sellado o lectura de temperatura. Revisar el horno antes del siguiente lote de silvestre.`,\n    rec3:`Mezcla de productos: el margen bruto por litro de silvestre (${silv.length} lotes) es de $${Math.round(margen(silv))} contra $${Math.round(margen(esp))} en espadín. Un lote más de silvestre al año vale más que dos de espadín, si hay agave.`};\n}});\nconst tip=(box,el,html,x,y)=>{const t=document.getElementById(box); if(!html){t.style.display='none';return;} t.innerHTML=html; t.style.display='block'; const r=el.getBoundingClientRect(); const p=t.parentElement.getBoundingClientRect(); let L=x-p.left+12, T=y-p.top+12; if(L+t.offsetWidth>p.width-8) L=x-p.left-t.offsetWidth-12; t.style.left=L+'px'; t.style.top=T+'px';};\nconst esc=s=>String(s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nfunction margins(svg,labels,font){ const t=svg.append('text').attr('font-size',font).style('visibility','hidden'); let w=0; labels.forEach(l=>{t.text(l); w=Math.max(w,t.node().getComputedTextLength());}); t.remove(); return w; }\nfunction barras(id,tipId,rows,key,fmt,accent){\n  const box=document.getElementById(id); box.innerHTML=''; const W=box.clientWidth||600, H=240;\n  const svg=d3.select(box).append('svg').attr('viewBox',`0 0 ${W} ${H}`).attr('width','100%');\n  const y=d3.scaleLinear([0,d3.max(rows,d=>d[key])*1.08],[H-28,10]);\n  const ml=margins(svg,y.ticks(4).map(fmt),11)+10, x=d3.scaleBand(rows.map(d=>d.lote),[ml,W-6]).padding(.3);\n  svg.append('g').attr('class','grid').selectAll('line').data(y.ticks(4)).join('line').attr('x1',ml).attr('x2',W-6).attr('y1',d=>y(d)).attr('y2',d=>y(d)).attr('stroke','var(--cds-chart-grid)');\n  svg.append('g').selectAll('text').data(y.ticks(4)).join('text').attr('x',ml-6).attr('y',d=>y(d)+4).attr('text-anchor','end').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(fmt);\n  svg.append('g').selectAll('text').data(rows).join('text').attr('x',d=>x(d.lote)+x.bandwidth()/2).attr('y',H-10).attr('text-anchor','middle').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(d=>d.lote);\n  svg.append('g').selectAll('rect').data(rows).join('rect').attr('x',d=>x(d.lote)).attr('width',x.bandwidth()).attr('y',d=>y(d[key])).attr('height',d=>y(0)-y(d[key])).attr('rx',4).attr('fill',d=>accent(d))\n   .on('mousemove',(e,d)=>tip(tipId,e.target,`<span class=\"d\">${esc(d.lote)} · ${esc(d.agave)} · ${esc(d.mes)}</span><br><b>$${mxn(d.costo_por_litro_mxn)}</b> por litro<br>${num(d.litros)} L · ${dec(d.rendimiento_kg_por_l)} kg/L · merma ${pct(d.merma_total)}`,e.clientX,e.clientY)).on('mouseleave',()=>tip(tipId));\n}\nfunction apiladas(id,tipId,legId,rows){\n  const etapas=[['merma_horneado','Horneado'],['merma_molienda','Molienda'],['merma_fermentacion','Fermentación'],['merma_destilacion','Destilación']];\n  document.getElementById(legId).innerHTML=etapas.map(([k,n],i)=>`<span><i style=\"background:${dash.colors[i]}\"></i>${n}</span>`).join('');\n  const box=document.getElementById(id); box.innerHTML=''; const W=box.clientWidth||600, H=240;\n  const svg=d3.select(box).append('svg').attr('viewBox',`0 0 ${W} ${H}`).attr('width','100%');\n  const y=d3.scaleLinear([0,Math.max(.3,d3.max(rows,d=>d.merma_total)*1.08)],[H-28,10]);\n  const ml=margins(svg,y.ticks(4).map(pct),11)+10, x=d3.scaleBand(rows.map(d=>d.lote),[ml,W-6]).padding(.3);\n  svg.append('g').selectAll('line').data(y.ticks(4)).join('line').attr('x1',ml).attr('x2',W-6).attr('y1',d=>y(d)).attr('y2',d=>y(d)).attr('stroke','var(--cds-chart-grid)');\n  svg.append('g').selectAll('text').data(y.ticks(4)).join('text').attr('x',ml-6).attr('y',d=>y(d)+4).attr('text-anchor','end').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(pct);\n  svg.append('g').selectAll('text').data(rows).join('text').attr('x',d=>x(d.lote)+x.bandwidth()/2).attr('y',H-10).attr('text-anchor','middle').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(d=>d.lote);\n  const series=d3.stack().keys(etapas.map(e=>e[0]))(rows);\n  svg.append('g').selectAll('g').data(series).join('g').attr('fill',(d,i)=>dash.colors[i]).selectAll('rect').data(d=>d.map(p=>({...p,key:d.key}))).join('rect')\n    .attr('x',d=>x(d.data.lote)).attr('width',x.bandwidth()).attr('y',d=>y(d[1])).attr('height',d=>Math.max(0,y(d[0])-y(d[1])-2))\n    .on('mousemove',(e,d)=>tip(tipId,e.target,`<span class=\"d\">${esc(d.data.lote)} · ${esc(d.data.agave)}</span><br>${etapas.map(([k,n],i)=>`<i style=\"display:inline-block;width:.5rem;height:.5rem;border-radius:2px;background:${dash.colors[i]};margin-right:.3rem\"></i>${n} <b>${pct1(d.data[k])}</b>`).join('<br>')}<br>Total <b>${pct1(d.data.merma_total)}</b>`,e.clientX,e.clientY)).on('mouseleave',()=>tip(tipId));\n}\nfunction lineas(id,tipId,legId,rows){\n  const canales=['Exportación','Nacional','Palenque']; const meses=[...new Set(rows.map(d=>d.mes))].sort();\n  document.getElementById(legId).innerHTML=canales.map((n,i)=>`<span><i style=\"background:${dash.colors[i]}\"></i>${n}</span>`).join('');\n  const box=document.getElementById(id); box.innerHTML=''; const W=box.clientWidth||600, H=240;\n  const svg=d3.select(box).append('svg').attr('viewBox',`0 0 ${W} ${H}`).attr('width','100%');\n  const fm=d3.utcFormat('%b %y'); const X=meses.map(m=>new Date(m+'-01T00:00:00Z'));\n  const y=d3.scaleLinear([0,d3.max(rows,d=>+d.litros)*1.1],[H-28,10]);\n  const ml=margins(svg,y.ticks(4).map(num),11)+10, mr=margins(svg,canales,11)+14;\n  const x=d3.scaleUtc(d3.extent(X),[ml,W-mr]);\n  svg.append('g').selectAll('line').data(y.ticks(4)).join('line').attr('x1',ml).attr('x2',W-mr).attr('y1',d=>y(d)).attr('y2',d=>y(d)).attr('stroke','var(--cds-chart-grid)');\n  svg.append('g').selectAll('text').data(y.ticks(4)).join('text').attr('x',ml-6).attr('y',d=>y(d)+4).attr('text-anchor','end').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(num);\n  const tx=X.filter((d,i)=>i%3===0); svg.append('g').selectAll('text').data(tx).join('text').attr('x',d=>x(d)).attr('y',H-10).attr('text-anchor','middle').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(fm);\n  const line=d3.line().x(d=>x(d.t)).y(d=>y(d.v));\n  canales.forEach((c,i)=>{ const s=meses.map((m,j)=>({t:X[j],v:+(rows.find(d=>d.mes===m&&d.canal===c)||{litros:0}).litros,mes:m}));\n    svg.append('path').attr('d',line(s)).attr('fill','none').attr('stroke',dash.colors[i]).attr('stroke-width',2).attr('stroke-linecap','round').attr('stroke-linejoin','round');\n    const last=s[s.length-1]; svg.append('circle').attr('cx',x(last.t)).attr('cy',y(last.v)).attr('r',4).attr('fill',dash.colors[i]).attr('stroke','var(--color-panel)').attr('stroke-width',2);\n    svg.append('text').attr('x',x(last.t)+8).attr('y',y(last.v)+4).attr('font-size',11).attr('fill','var(--color-fg)').text(c); });\n  const ov=svg.append('rect').attr('x',ml).attr('y',10).attr('width',W-mr-ml).attr('height',H-38).attr('fill','transparent'); const rule=svg.append('line').attr('y1',10).attr('y2',H-28).attr('stroke','var(--cds-chart-reference)').style('display','none');\n  ov.on('mousemove',e=>{ const [px]=d3.pointer(e); const i=d3.bisectCenter(X.map(d=>x(d)),px); rule.style('display',null).attr('x1',x(X[i])).attr('x2',x(X[i])); const m=meses[i];\n    tip(tipId,e.target,`<span class=\"d\">${esc(fm(X[i]))}</span><br>${canales.map((c,k)=>{const r=rows.find(d=>d.mes===m&&d.canal===c)||{litros:0,ingreso_mxn:0}; return `<i style=\"display:inline-block;width:.5rem;height:.5rem;border-radius:2px;background:${dash.colors[k]};margin-right:.3rem\"></i>${c} <b>${num(+r.litros)} L</b> · $${mxn(+r.ingreso_mxn)}`;}).join('<br>')}`,e.clientX,e.clientY); }).on('mouseleave',()=>{rule.style('display','none');tip(tipId);});\n}\nfunction tabla(rows,med){ const tb=document.querySelector('#tabla tbody'); tb.innerHTML=''; rows.forEach(d=>{ const tr=document.createElement('tr'); if(d.merma_total>med+0.05) tr.className='alerta';\n  [d.lote,d.agave,num(d.kg_agave),num(Math.round(d.litros)),dec(d.rendimiento_kg_por_l),dec(d.grado),pct1(d.merma_fermentacion),pct1(d.merma_horneado),'$'+mxn(d.costo_por_litro_mxn),'$'+mxn(d.precio_venta_litro_mxn)].forEach(v=>{const td=document.createElement('td'); td.textContent=v; tr.appendChild(td);}); tb.appendChild(tr); }); }\nfunction fail(id){ const b=document.getElementById(id); b.innerHTML='<div class=\"fail\" style=\"min-height:240px\">Failed to load</div>'; }\ndash.onData(()=>{\n  const L=dash.data('lotes'), V=dash.data('ventas'), K=dash.data('kpi');\n  document.querySelectorAll('.dash-skeleton').forEach(e=>{ if(L.status!=='loading') e.classList.remove('dash-skeleton'); });\n  if(K.status==='ok'&&K.data){ const k=K.data; document.getElementById('lead').textContent=k.lead;\n    const set=(f,v)=>{document.querySelector(`[data-field=\"${f}\"]`).textContent=v;};\n    set('litros',num(k.litros)+' L'); set('costo_litro','$'+mxn(k.costo_litro)); set('rendimiento',dec(k.rendimiento)+' kg/L'); set('merma',pct1(k.merma)); set('litros_perdidos',num(k.litros_perdidos)+' L'); set('rec1',k.rec1); set('rec2',k.rec2); set('rec3',k.rec3); }\n  if(L.status==='ok'){ const rows=toRows(L.data); const med=[...rows].map(d=>d.merma_total).sort((a,b)=>a-b)[Math.floor(rows.length/2)];\n    barras('p-costo','t-costo',rows,'costo_por_litro_mxn',v=>'$'+mxn(v),d=>d.agave==='Espadín'?dash.colors[0]:'var(--cds-chart-muted)');\n    apiladas('p-merma','t-merma','l-merma',rows); tabla(rows,med); }\n  else if(L.status==='error'||L.status==='connect'){ fail('p-costo'); fail('p-merma'); }\n  if(V.status==='ok') lineas('p-ventas','t-ventas','l-ventas',V.data); else if(V.status==='error'||V.status==='connect') fail('p-ventas');\n});\n</script>\n"}