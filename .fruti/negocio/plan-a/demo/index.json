{"text": "<style>\n.pz{--cl-ind:#4338ca;--cl-cur:#4d7c0f}\n@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .pz{--cl-ind:#8b8cf8;--cl-cur:#c6f23d}}\n:root[data-theme=dark] .pz{--cl-ind:#8b8cf8;--cl-cur:#c6f23d}\n.pz .top{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--cds-gap-md);flex-wrap:wrap}\n.pz .marca{width:150px;flex:none}\n.pz .marca svg{width:100%;height:auto;display:block}\n.pz .pie{display:flex;justify-content:space-between;align-items:center;gap:var(--cds-gap-md);flex-wrap:wrap;border-top:1px solid var(--color-border-line);padding-top:var(--cds-pad-md)}\n.pz .pie .firma{width:230px}\n.pz .pie .firma svg{width:100%;height:auto;display:block}\n.pz{font-family:var(--font-anthropic-sans);display:grid;gap:var(--cds-gap-lg);max-width:1100px;margin-inline:auto}\n.pz h1{font-family:var(--font-anthropic-serif);font-weight:400;font-size:var(--cds-font-size-title);margin:0}\n.pz .lead{margin:0;color:var(--color-fg-muted);font-size:var(--cds-font-size-body);max-width:70ch}\n.pz .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,10rem),1fr));gap:var(--cds-gap-md)}\n.pz .tile{background:var(--color-panel);border:1px solid var(--color-border-line);border-radius:var(--cds-radius);padding:var(--cds-pad-lg);display:grid;gap:var(--cds-gap-xs);min-width:0}\n.pz .tile .k{font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n.pz .tile .v{font-family:var(--font-anthropic-serif);font-weight:400;font-size:1.9rem;line-height:1.1;font-variant-numeric:tabular-nums}\n.pz .tile .n{font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n.pz .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,24rem),1fr));gap:var(--cds-gap-md)}\n.pz .card{background:var(--color-panel);border:1px solid var(--color-border-line);border-radius:var(--cds-radius);padding:var(--cds-pad-lg);display:grid;gap:var(--cds-gap-sm);min-width:0;position:relative}\n.pz .card h2{margin:0;font-size:var(--cds-font-size-heading);font-weight:var(--cds-font-weight-medium)}\n.pz .card .note{margin:0;font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n.pz .plot{min-height:240px}\n.pz svg{display:block;width:100%;height:auto}\n.pz .legend{display:flex;gap:var(--cds-gap-md);flex-wrap:wrap;font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n.pz .legend i{display:inline-block;width:.6rem;height:.6rem;border-radius:2px;margin-right:.35rem;vertical-align:-1px}\n.pz .tip{position:absolute;background:var(--cds-surface-popover);border:1px solid var(--cds-border);border-radius:var(--cds-radius);box-shadow:var(--cds-shadow-popover);padding:var(--cds-pad-xs) var(--cds-pad-sm);font-size:var(--cds-font-size-caption);pointer-events:none;display:none;max-width:16rem}\n.pz .tip b{font-weight:600}\n.pz .tip .d{color:var(--cds-text-secondary)}\n.pz .wrap{overflow:auto;max-height:420px}\n.pz table{border-collapse:collapse;width:100%;font-size:var(--cds-font-size-caption);font-variant-numeric:tabular-nums}\n.pz th,.pz td{text-align:right;padding:6px 8px;border-bottom:1px solid var(--color-border-line);white-space:nowrap}\n.pz th:first-child,.pz td:first-child,.pz th:nth-child(2),.pz td:nth-child(2){text-align:left}\n.pz th{position:sticky;top:0;background:var(--color-panel);color:var(--color-fg-muted);font-weight:var(--cds-font-weight-medium)}\n.pz tr.alerta td{color:var(--color-bad)}\n.pz .fail{display:flex;align-items:center;justify-content:center;gap:.4rem;color:var(--color-fg-muted);font-size:var(--cds-font-size-caption)}\n.pz .fail::before{content:\"\";width:.375rem;height:.375rem;border-radius:50%;background:var(--color-bad)}\n.pz [data-dash-source-state=empty]{color:transparent}\n.pz [data-dash-source-state=refreshing]{opacity:.5;transition:opacity var(--cds-dur-slow)}\n.pz .recs{display:grid;gap:var(--cds-gap-sm);margin:0;padding-left:1.2rem}\n.pz .recs li{font-size:var(--cds-font-size-body)}\n.pz .muestra{font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n</style>\n<div class=\"pz\">\n<header class=\"top\"><div><h1 id=\"titulo\">Palenque San Isidro · producción 2025–2026</h1>\n  <p class=\"lead\" id=\"lead\" data-source=\"kpi\" data-field=\"lead\">—</p></div><div class=\"marca\" aria-label=\"CLNDA Studio\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 478 120\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><g transform=\"translate(-6 -4) scale(1.95)\"><path d=\"M40 10 H36 a8 8 0 0 0 -8 8 V26 a6 6 0 0 1 -6 6 a6 6 0 0 1 6 6 V46 a8 8 0 0 0 8 8 H40\" stroke=\"var(--cl-ind)\" stroke-width=\"7\" transform=\"translate(-3 0)\"/><circle cx=\"46\" cy=\"32\" r=\"6.5\" fill=\"var(--color-fg)\"/></g><g transform=\"translate(118 0)\"><path d=\"M33.2 99.4Q20.200000000000003 99.4 12.600000000000001 92.15Q5.0 84.9 5.0 71.4V54.599999999999994Q5.0 41.099999999999994 12.600000000000001 33.849999999999994Q20.200000000000003 26.599999999999994 33.2 26.599999999999994Q46.1 26.599999999999994 53.150000000000006 33.64999999999999Q60.2 40.699999999999996 60.2 53.0V53.599999999999994H47.2V52.599999999999994Q47.2 46.4 43.75 42.4Q40.300000000000004 38.4 33.2 38.4Q26.200000000000003 38.4 22.200000000000003 42.7Q18.2 47.0 18.2 54.4V71.6Q18.2 78.9 22.200000000000003 83.25Q26.200000000000003 87.6 33.2 87.6Q40.300000000000004 87.6 43.75 83.55Q47.2 79.5 47.2 73.4V71.6H60.2V73.0Q60.2 85.3 53.150000000000006 92.35Q46.1 99.4 33.2 99.4ZM69.5 98.0V28.0H82.7V86.0H114.70000000000002V98.0ZM122.2 98.0V28.0H147.3L161.20000000000002 89.0H163.0V28.0H176.0V98.0H150.9L137.0 37.0H135.20000000000002V98.0ZM185.70000000000002 98.0V86.4H194.90000000000003V39.599999999999994H185.70000000000002V28.0H214.50000000000003Q228.60000000000002 28.0 235.95000000000002 35.15Q243.3 42.3 243.3 56.4V69.6Q243.3 83.7 235.95000000000002 90.85Q228.60000000000002 98.0 214.50000000000003 98.0ZM208.10000000000002 86.0H214.70000000000002Q222.70000000000002 86.0 226.40000000000003 81.8Q230.10000000000002 77.6 230.10000000000002 70.0V56.0Q230.10000000000002 48.3 226.40000000000003 44.15Q222.70000000000002 40.0 214.70000000000002 40.0H208.10000000000002ZM247.40000000000003 98.0 265.8 28.0H288.8L307.20000000000005 98.0H293.6L289.8 82.6H264.8L261.0 98.0ZM267.90000000000003 70.4H286.70000000000005L278.20000000000005 36.3H276.40000000000003Z\" fill=\"var(--color-fg)\"/><rect x=\"315.50\" y=\"26.00\" width=\"44.00\" height=\"72.00\" rx=\"5.00\" fill=\"var(--cl-cur)\"/></g></svg></div>\n</header>\n<section class=\"tiles\" id=\"indicadores\">\n  <div class=\"tile\"><span class=\"k\">Litros producidos</span><span class=\"v\" data-source=\"kpi\" data-field=\"litros\">—</span><span class=\"n\">12 lotes · 12 meses</span></div>\n  <div class=\"tile\"><span class=\"k\">Costo por litro</span><span class=\"v\" data-source=\"kpi\" data-field=\"costo_litro\">—</span><span class=\"n\">promedio ponderado, MXN</span></div>\n  <div class=\"tile\"><span class=\"k\">Rendimiento</span><span class=\"v\" data-source=\"kpi\" data-field=\"rendimiento\">—</span><span class=\"n\">kg de agave por litro, promedio</span></div>\n  <div class=\"tile\"><span class=\"k\">Merma total</span><span class=\"v\" data-source=\"kpi\" data-field=\"merma\">—</span><span class=\"n\">horneado + molienda + fermentación + destilación</span></div>\n  <div class=\"tile\"><span class=\"k\">Litros perdidos en mermas atípicas</span><span class=\"v\" data-source=\"kpi\" data-field=\"litros_perdidos\">—</span><span class=\"n\">lotes por encima de la mediana + 5 puntos</span></div>\n</section>\n<section class=\"grid\">\n  <div class=\"card\" id=\"c-costo\"><h2>Costo por litro por lote</h2><p class=\"note\">Los lotes de agave silvestre cuestan más por litro; dentro de espadín, los picos son mermas, no agave.</p><div class=\"plot\" id=\"p-costo\" data-source=\"lotes\"></div><div class=\"tip\" id=\"t-costo\"></div></div>\n  <div class=\"card\" id=\"c-merma\"><h2>Mermas por etapa por lote</h2><p class=\"note\">Porcentaje perdido en cada etapa. Un lote sano suma 15 a 25 %.</p><div class=\"legend\" id=\"l-merma\"></div><div class=\"plot\" id=\"p-merma\" data-source=\"lotes\"></div><div class=\"tip\" id=\"t-merma\"></div></div>\n</section>\n<section class=\"grid\">\n  <div class=\"card\" id=\"c-ventas\"><h2>Litros vendidos por canal por mes</h2><p class=\"note\">Exportación paga mejor por litro; palenque es volumen chico.</p><div class=\"legend\" id=\"l-ventas\"></div><div class=\"plot\" id=\"p-ventas\" data-source=\"ventas\"></div><div class=\"tip\" id=\"t-ventas\"></div></div>\n  <div class=\"card\" id=\"c-recs\"><h2>Tres recomendaciones</h2><p class=\"note\">Calculadas de los datos; se reescriben si los datos cambian.</p><ol class=\"recs\" id=\"recs\"><li data-source=\"kpi\" data-field=\"rec1\">—</li><li data-source=\"kpi\" data-field=\"rec2\">—</li><li data-source=\"kpi\" data-field=\"rec3\">—</li></ol></div>\n</section>\n<section class=\"card\" id=\"c-tabla\"><h2>Los doce lotes</h2><p class=\"note\">En rojo, lotes con alguna merma atípica.</p>\n<div class=\"wrap\"><table id=\"tabla\" data-source=\"lotes\" data-row-key=\"lote\"><thead><tr><th data-field=\"lote\">Lote</th><th data-field=\"agave\">Agave</th><th data-field=\"kg_agave\">kg agave</th><th data-field=\"litros\">Litros</th><th data-field=\"rendimiento_kg_por_l\">kg/L</th><th data-field=\"grado\">°</th><th data-field=\"merma_fermentacion\">Merma ferm.</th><th data-field=\"merma_horneado\">Merma horno</th><th data-field=\"costo_por_litro_mxn\">$/L</th><th data-field=\"precio_venta_litro_mxn\">Precio/L</th></tr></thead><tbody></tbody></table></div></section>\n<footer class=\"pie\"><p class=\"muestra\">Datos de muestra: un palenque ficticio con cifras realistas, preparado para mostrar el servicio. Con sus registros reales, cada número de esta página sale de su propia producción.</p><div class=\"firma\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 296 30\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><g transform=\"scale(0.45)\"><path d=\"M40