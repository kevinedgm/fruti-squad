2.0V11.088000000000001H277.43V22.0ZM276.044 9.812000000000001Q275.296 9.812000000000001 274.779 9.328000000000001Q274.262 8.844000000000001 274.262 8.052000000000001Q274.262 7.260000000000002 274.779 6.776000000000002Q275.296 6.292000000000002 276.044 6.292000000000002Q276.814 6.292000000000002 277.32000000000005 6.776000000000002Q277.826 7.260000000000002 277.826 8.052000000000001Q277.826 8.844000000000001 277.32000000000005 9.328000000000001Q276.814 9.812000000000001 276.044 9.812000000000001ZM285.702 22.308Q284.07399999999996 22.308 282.77599999999995 21.648Q281.47799999999995 20.988 280.72999999999996 19.734Q279.98199999999997 18.48 279.98199999999997 16.72V16.368000000000002Q279.98199999999997 14.608 280.72999999999996 13.354000000000001Q281.47799999999995 12.100000000000001 282.77599999999995 11.440000000000001Q284.07399999999996 10.780000000000001 285.702 10.780000000000001Q287.33 10.780000000000001 288.628 11.440000000000001Q289.926 12.100000000000001 290.674 13.354000000000001Q291.42199999999997 14.608 291.42199999999997 16.368000000000002V16.72Q291.42199999999997 18.48 290.674 19.734Q289.926 20.988 288.628 21.648Q287.33 22.308 285.702 22.308ZM285.702 19.844Q286.97799999999995 19.844 287.81399999999996 19.019Q288.65 18.194 288.65 16.654V16.434Q288.65 14.894 287.82499999999993 14.068999999999999Q286.99999999999994 13.244 285.702 13.244Q284.426 13.244 283.59 14.068999999999999Q282.75399999999996 14.894 282.75399999999996 16.434V16.654Q282.75399999999996 18.194 283.59 19.019Q284.426 19.844 285.702 19.844Z\" fill=\"var(--color-fg)\" opacity=\".85\"/></svg></div></footer>\n</div>\n<script>\nconst num=d3.format(','), pct=d3.format('.0%'), pct1=d3.format('.1%'), mxn=d3.format(',.0f'), dec=d3.format('.1f');\nconst toRows=r=>r.map(d=>({...d,kg_agave:+d.kg_agave,litros:+d.litros,rendimiento_kg_por_l:+d.rendimiento_kg_por_l,grado:+d.grado,merma_horneado:+d.merma_horneado,merma_molienda:+d.merma_molienda,merma_fermentacion:+d.merma_fermentacion,merma_destilacion:+d.merma_destilacion,costo_total_mxn:+d.costo_total_mxn,costo_por_litro_mxn:+d.costo_por_litro_mxn,dias_proceso:+d.dias_proceso,precio_venta_litro_mxn:+d.precio_venta_litro_mxn,merma_total:+d.merma_horneado+ +d.merma_molienda+ +d.merma_fermentacion+ +d.merma_destilacion}));\ndash.calc('kpi',{inputs:['lotes'],title:'Indicadores del periodo',description:'Totales, promedios ponderados, mermas atípicas y tres recomendaciones a partir de los lotes.',fn:(lotes)=>{\n  const r=lotes.map(d=>({...d,kg:+d.kg_agave,l:+d.litros,c:+d.costo_total_mxn,mt:+d.merma_horneado+ +d.merma_molienda+ +d.merma_fermentacion+ +d.merma_destilacion,mf:+d.merma_fermentacion,mh:+d.merma_horneado,p:+d.precio_venta_litro_mxn}));\n  const litros=r.reduce((a,d)=>a+d.l,0), costo=r.reduce((a,d)=>a+d.c,0), kg=r.reduce((a,d)=>a+d.kg,0);\n  const medMt=[...r].map(d=>d.mt).sort((a,b)=>a-b)[Math.floor(r.length/2)];\n  const atip=r.filter(d=>d.mt>medMt+0.05);\n  const perdidos=atip.reduce((a,d)=>a+d.l*(d.mt-medMt)/(1-d.mt),0);\n  const esp=r.filter(d=>d.agave==='Espadín'), silv=r.filter(d=>d.agave!=='Espadín');\n  const margen=g=>g.reduce((a,d)=>a+(d.p-d.c/d.l)*d.l,0)/g.reduce((a,d)=>a+d.l,0);\n  const peorF=[...r].sort((a,b)=>b.mf-a.mf)[0], peorH=[...r].sort((a,b)=>b.mh-a.mh)[0];\n  return {litros:Math.round(litros),costo_litro:Math.round(costo/litros),rendimiento:+(kg/litros).toFixed(1),merma:+(r.reduce((a,d)=>a+d.mt*d.l,0)/litros).toFixed(3),litros_perdidos:Math.round(perdidos),\n    lead:`${Math.round(litros).toLocaleString('es-MX')} litros en 12 lotes a un costo promedio de $${Math.round(costo/litros)} por litro; ${atip.length} lotes con mermas atípicas se llevaron unos ${Math.round(perdidos)} litros, el equivalente a $${Math.round(perdidos*(costo/litros)).toLocaleString('es-MX')} de costo sin producto.`,\n    rec1:`Fermentación: el lote ${peorF.lote} perdió ${Math.round(peorF.mf*100)} % en tina contra una mediana de ${Math.round(100*[...r].map(d=>d.mf).sort((a,b)=>a-b)[Math.floor(r.length/2)])} %. Registrar temperatura y días de tina por lote permite ver la causa antes de destilar.`,\n    rec2:`Horneado: el lote ${peorH.lote} perdió ${Math.round(peorH.mh*100)} % en el horno; una merma de horneado arriba de 10 % casi siempre es sellado o lectura de temperatura. Revisar el horno antes del siguiente lote de silvestre.`,\n    rec3:`Mezcla de productos: el margen bruto por litro de silvestre (${silv.length} lotes) es de $${Math.round(margen(silv))} contra $${Math.round(margen(esp))} en espadín. Un lote más de silvestre al año vale más que dos de espadín, si hay agave.`};\n}});\nconst tip=(box,el,html,x,y)=>{const t=document.getElementById(box); if(!html){t.style.display='none';return;} t.innerHTML=html; t.style.display='block'; const r=el.getBoundingClientRect(); const p=t.parentElement.getBoundingClientRect(); let L=x-p.left+12, T=y-p.top+12; if(L+t.offsetWidth>p.width-8) L=x-p.left-t.offsetWidth-12; t.style.left=L+'px'; t.style.top=T+'px';};\nconst esc=s=>String(s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nfunction margins(svg,labels,font){ const t=svg.append('text').attr('font-size',font).style('visibility','hidden'); let w=0; labels.forEach(l=>{t.text(l); w=Math.max(w,t.node().getComputedTextLength());}); t.remove(); return w; }\nfunction barras(id,tipId,rows,key,fmt,accent){\n  const box=document.getElementById(id); box.innerHTML=''; const W=box.clientWidth||600, H=240;\n  const svg=d3.select(box).append('svg').attr('viewBox',`0 0 ${W} ${H}`).attr('width','100%');\n  const y=d3.scaleLinear([0,d3.max(rows,d=>d[key])*1.08],[H-28,10]);\n  const ml=margins(svg,y.ticks(4).map(fmt),11)+10, x=d3.scaleBand(rows.map(d=>d.lote),[ml,W-6]).padding(.3);\n  svg.append('g').attr('class','grid').selectAll('line').data(y.ticks(4)).join('line').attr('x1',ml).attr('x2',W-6).attr('y1',d=>y(d)).attr('y2',d=>y(d)).attr('stroke','var(--cds-chart-grid)');\n  svg.append('g').selectAll('text').data(y.ticks(4)).join('text').attr('x',ml-6).attr('y',d=>y(d)+4).attr('text-anchor','end').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(fmt);\n  svg.append('g').selectAll('text').data(rows).join('text').attr('x',d=>x(d.lote)+x.bandwidth()/2).attr('y',H-10).attr('text-anchor','middle').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(d=>d.lote);\n  svg.append('g').selectAll('rect').data(rows).join('rect').attr('x',d=>x(d.lote)).attr('width',x.bandwidth()).attr('y',d=>y(d[key])).attr('height',d=>y(0)-y(d[key])).attr('rx',4).attr('fill',d=>accent(d))\n   .on('mousemove',(e,d)=>tip(tipId,e.target,`<span class=\"d\">${esc(d.lote)} · ${esc(d.agave)} · ${esc(d.mes)}</span><br><b>$${mxn(d.costo_por_litro_mxn)}</b> por litro<br>${num(d.litros)} L · ${dec(d.rendimiento_kg_por_l)} kg/L · merma ${pct(d.merma_total)}`,e.clientX,e.clientY)).on('mouseleave',()=>tip(tipId));\n}\nfunction apiladas(id,tipId,legId,rows){\n  const etapas=[['merma_horneado','Horneado'],['merma_molienda','Molienda'],['merma_fermentacion','Fermentación'],['merma_destilacion','Destilación']];\n  document.getElementById(legId).innerHTML=etapas.map(([k,n],i)=>`<span><i style=\"background:${dash.colors[i]}\"></i>${n}</span>`).join('');\n  const box=document.getElementById(id); box.innerHTML=''; const W=box.clientWidth||600, H=240;\n  const svg=d3.select(box).append('svg').attr('viewBox',`0 0 ${W} ${H}`).attr('width','100%');\n  const y=d3.scaleLinear([0,Math.max(.3,d3.max(rows,d=>d.merma_total)*1.08)],[H-28,10]);\n  const ml=margins(svg,y.ticks(4).map(pct),11)+10, x=d3.scaleBand(rows.map(d=>d.lote),[ml,W-6]).padding(.3);\n  svg.append('g').selectAll('line').data(y.ticks(4)).join('line').attr('x1',ml).attr('x2',W-6).attr('y1',d=>y(d)).attr('y2',d=>y(d)).attr('stroke','var(--cds-chart-grid)');\n  svg.append('g').selectAll('text').data(y.ticks(4)).join('text').attr('x',ml-6).attr('y',d=>y(d)+4).attr('text-anchor','end').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(pct);\n  svg.append('g').selectAll('text').data(rows).join('text').attr('x',d=>x(d.lote)+x.bandwidth()/2).attr('y',H-10).attr('text-anchor','middle').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(d=>d.lote);\n  const series=d3.stack().keys(etapas.map(e=>e[0]))(rows);\n  svg.append('g').selectAll('g').data(series).join('g').attr('fill',(d,i)=>dash.colors[i]).selectAll('rect').data(d=>d.map(p=>({...p,key:d.key}))).join('rect')\n    .attr('x',d=>x(d.data.lote)).attr('width',x.bandwidth()).attr('y',d=>y(d[1])).attr('height',d=>Math.max(0,y(d[0])-y(d[1])-2))\n    .on('mousemove',(e,d)=>tip(tipId,e.target,`<span class=\"d\">${esc(d.data.lote)} · ${esc(d.data.agave)}</span><br>${etapas.map(([k,n],i)=>`<i style=\"display:inline-block;width:.5rem;height:.5rem;border-radius:2px;background:${dash.colors[i]};margin-right:.3rem\"></i>${n} <b>${pct1(d.data[k])}</b>`).join('<br>')}<br>Total <b>${pct1(d.data.merma_total)}</b>`,e.clientX,e.clientY)).on('mouseleave',()=>tip(tipId));\n}\nfunction lineas(id,tipId,legId,rows){\n  const canales=['Exportación','Nacional','Palenque']; const meses=[...new Set(rows.map(d=>d.mes))].sort();\n  document.getElementById(legId).innerHTML=canales.map((n,i)=>`<span><i style=\"background:${dash.colors[i]}\"></i>${n}</span>`).join('');\n  const box=document.getElementById(id); box.innerHTML=''; const W=box.clientWidth||600, H=240;\n  const svg=d3.select(box).append('svg').attr('viewBox',`0 0 ${W} ${H}`).attr('width','100%');\n  const fm=d3.utcFormat('%b %y'); const X=meses.map(m=>new Date(m+'-01T00:00:00Z'));\n  const y=d3.scaleLinear([0,d3.max(rows,d=>+d.litros)*1.1],[H-28,10]);\n  const ml=margins(svg,y.ticks(4).map(num),11)+10, mr=margins(svg,canales,11)+14;\n  const x=d3.scaleUtc(d3.extent(X),[ml,W-mr]);\n  svg.append('g').selectAll('line').data(y.ticks(4)).join('line').attr('x1',ml).attr('x2',W-mr).attr('y1',d=>y(d)).attr('y2',d=>y(d)).attr('stroke','var(--cds-chart-grid)');\n  svg.append('g').selectAll('text').data(y.ticks(4)).join('text').attr('x',ml-6).attr('y',d=>y(d)+4).attr('text-anchor','end').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(num);\n  const tx=X.filter((d,i)=>i%3===0); svg.append('g').selectAll('text').data(tx).join('text').attr('x',d=>x(d)).attr('y',H-10).attr('text-anchor','middle').attr('font-size',11).attr('fill','var(--color-fg-muted)').text(fm);\n  const line=d3.line().x(d=>x(d.t)).y(d=>y(d.v));\n  canales.forEach((c,i)=>{ const s=meses.map((m,j)=>({t:X[j],v:+(rows.find(d=>d.mes===m&&d.canal===c)||{litros:0}).litros,mes:m}));\n    svg.append('path').attr('d',line(s)).attr('fill','none').attr('stroke',dash.colors[i]).attr('stroke-width',2).attr('stroke-linecap','round').attr('stroke-linejoin','round');\n    const last=s[s.length-1]; svg.append('circle').attr('cx',x(last.t)).attr('cy',y(last.v)).attr('r',4).attr('fill',dash.colors[i]).attr('stroke','var(--color-panel)').attr('stroke-width',2);\n    svg.append('text').attr('x',x(last.t)+8).attr('y',y(last.v)+4).attr('font-size',11).attr('fill','var(--color-fg)').text(c); });\n  const ov=svg.append('rect').attr('x',ml).attr('y',10).attr('width',W-mr-ml).attr('height',H-38).attr('fill','transparent'); const rule=svg.append('line').attr('y1',10).attr('y2',H-28).attr('stroke','var(--cds-chart-reference)').style('display','none');\n  ov.on('mousemove',e=>{ const [px]=d3.pointer(e); const i=d3.bisectCenter(X.map(d=>x(d)),px); rule.style('display',null).attr('x1',x(X[i])).attr('x2',x(X[i])); const m=meses[i];\n    tip(tipId,e.target,`<span class=\"d\">${esc(fm(X[i]))}</span><br>${canales.map((c,k)=>{const r=rows.find(d=>d.mes===m&&d.canal===c)||{litros:0,ingreso_mxn:0}; return `<i style=\"display:inline-block;width:.5rem;height:.5rem;border-radius:2px;background:${dash.colors[k]};margin-right:.3rem\"></i>${c} <b>${num(+r.litros)} L</b> · $${mxn(+r.ingreso_mxn)}`;}).join('<br>')}`,e.clientX,e.clientY); }).on('mouseleave',()=>{rule.style('display','none');tip(tipId);});\n}\nfunction tabla(rows,med){ const tb=document.querySelector('#tabla tbody'); tb.innerHTML=''; rows.forEach(d=>{ const tr=document.createElement('tr'); if(d.merma_total>med+0.05) tr.className='alerta';\n  [d.lote,d.agave,num(d.kg_agave),num(Math.round(d.litros)),dec(d.rendimiento_kg_por_l),dec(d.grado),pct1(d.merma_fermentacion),pct1(d.merma_horneado),'$'+mxn(d.costo_por_litro_mxn),'$'+mxn(d.precio_venta_litro_mxn)].forEach(v=>{const td=document.createElement('td'); td.textContent=v; tr.appendChild(td);}); tb.appendChild(tr); }); }\nfunction fail(id){ const b=document.getElementById(id); b.innerHTML='<div class=\"fail\" style=\"min-height:240px\">Failed to load</div>'; }\ndash.onData(()=>{\n  const L=dash.data('lotes'), V=dash.data('ventas'), K=dash.data('kpi');\n  document.querySelectorAll('.dash-skeleton').forEach(e=>{ if(L.status!=='loading') e.classList.remove('dash-skeleton'); });\n  if(K.status==='ok'&&K.data){ const k=K.data; document.getElementById('lead').textContent=k.lead;\n    const set=(f,v)=>{document.querySelector(`[data-field=\"${f}\"]`).textContent=v;};\n    set('litros',num(k.litros)+' L'); set('costo_litro','$'+mxn(k.costo_litro)); set('rendimiento',dec(k.rendimiento)+' kg/L'); set('merma',pct1(k.merma)); set('litros_perdidos',num(k.litros_perdidos)+' L'); set('rec1',k.rec1); set('rec2',k.rec2); set('rec3',k.rec3); }\n  if(L.status==='ok'){ const rows=toRows(L.data); const med=[...rows].map(d=>d.merma_total).sort((a,b)=>a-b)[Math.floor(rows.length/2)];\n    barras('p-costo','t-costo',rows,'costo_por_litro_mxn',v=>'$'+mxn(v),d=>d.agave==='Espadín'?dash.colors[0]:'var(--cds-chart-muted)');\n    apiladas('p-merma','t-merma','l-merma',rows); tabla(rows,med); }\n  else if(L.status==='error'||L.status==='connect'){ fail('p-costo'); fail('p-merma'); }\n  if(V.status==='ok') lineas('p-ventas','t-ventas','l-ventas',V.data); else if(V.status==='error'||V.status==='connect') fail('p-ventas');\n});\n</script>\n"}